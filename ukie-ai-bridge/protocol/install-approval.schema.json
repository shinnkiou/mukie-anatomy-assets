{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ukie.local/schemas/install-approval.schema.json",
  "title": "UKIE Tool Scout One-click Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_key", "approved_at", "approved_by", "approval_mode", "tools"],
  "properties": {
    "schema_version": {"const": "ukie_install_approval_v1"},
    "batch_key": {"type": "string", "pattern": "^[A-Z0-9_\\-]{4,100}$"},
    "approved_at": {"type": "string", "format": "date-time"},
    "approved_by": {"type": "string", "minLength": 1},
    "approval_mode": {"const": "ONE_CLICK_ALL"},
    "approval_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "second_base44_click_required": {"const": false},
        "resolve_within_approved_source_and_version_policy": {"const": true},
        "pause_only_for_permission_or_policy_escalation": {"const": true},
        "unknown_tool_execution": {"const": "DENY"},
        "arbitrary_shell": {"const": "DENY"}
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_key", "name", "source_type", "official_url", "publisher", "recommended_version", "version_policy", "requires_admin", "requires_driver", "requires_login", "risk"],
        "properties": {
          "tool_key": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["winget", "official_portable", "official_installer", "existing_only", "manual"]},
          "package_id": {"type": "string"},
          "official_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "publisher": {"type": "string", "minLength": 1},
          "recommended_version": {"type": "string", "minLength": 1},
          "version_policy": {"type": "string", "minLength": 1},
          "requires_admin": {"type": "boolean"},
          "requires_driver": {"type": "boolean"},
          "requires_login": {"type": "boolean"},
          "risk": {"enum": ["LOW", "MEDIUM", "HIGH"]}
        }
      }
    }
  }
}
