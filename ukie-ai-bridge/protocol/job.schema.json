{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ukie.local/schemas/job.schema.json",
  "title": "UKIE AI Bridge Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "action", "project", "input", "requested_at"],
  "properties": {
    "schema_version": {"const": "ukie_job_v1"},
    "job_id": {"type": "string", "pattern": "^[A-Z0-9_\\-]{4,80}$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Z0-9_\\-]{1,80}$"},
    "action": {
      "enum": ["device_status", "analyze_blend", "upload_results"]
    },
    "project": {"type": "string", "enum": ["BP3D", "CSMC", "BRIDGE_TEST"]},
    "device_id": {"type": ["string", "null"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 1800, "default": 300},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drive_file_id", "sha256", "original_filename"],
      "properties": {
        "drive_file_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "original_filename": {"type": "string", "minLength": 1},
        "byte_size": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "blender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_version": {"type": "string", "default": "4.2.23"},
        "background": {"const": true}
      }
    }
  }
}
